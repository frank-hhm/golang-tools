	ballSysInfo  = ballUser32.NewProc("SystemParametersInfoW")
	ballMetrics  = ballUser32.NewProc("GetSystemMetrics")
	ballGetDpi   = ballUser32.NewProc("GetDpiForSystem")
	ballCreatePM = ballUser32.NewProc("CreatePopupMenu")
