// ---------------- Win32 缁撴瀯浣?----------------

type ballPoint struct{ X, Y int32 }
type ballSize struct{ CX, CY int32 }
type ballRect struct {
	Left, Top, Right, Bottom int32
}

// MEASUREITEMSTRUCT / DRAWITEMSTRUCT锛堜粎鑿滃崟 owner-draw 鐢ㄥ埌鐨勫瓧娈靛竷灞€锛宎md64 瀵归綈涓?C 涓€鑷达級
type ballMeasureItem struct {
	CtlType    uint32
	CtlID      uint32
	ItemID     uint32
	ItemWidth  uint32
	ItemHeight uint32
	ItemData   uintptr
}
type ballDrawItem struct {
	CtlType    uint32
	CtlID      uint32
	ItemID     uint32
	ItemAction uint32
	ItemState  uint32
	HwndItem   uintptr
	HDC        uintptr
	RcItem     ballRect
	ItemData   uintptr
}

// MENUINFO锛圫etMenuInfo 鐢紝浠呭彇鑳屾櫙鐢诲埛瀛楁锛沘md64 瀵归綈涓?C 涓€鑷达紝size=40锛?type ballMenuInfo struct {
	CbSize    uint32
	FMask     uint32
	DwStyle   uint32
	CyMin     uint32
	HbrBack   uintptr
	DwContext uint32
	DwMenuID  uintptr
}
type ballBlend struct {
	BlendOp             byte
	BlendFlags          byte
	SourceConstantAlpha byte
	AlphaFormat         byte
}
type ballMsg struct {
	Hwnd    uintptr
	Message uint32
	WParam  uintptr
	LParam  uintptr
